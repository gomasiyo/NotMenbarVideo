{
  "manifest_version": 3,
  "name": "YouTube Member-Only Hider",
  "version": "1.0",
  "description": "YouTubeのメンバー限定コンテンツを非表示にし、レイアウトを詰めます。",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ]
}
